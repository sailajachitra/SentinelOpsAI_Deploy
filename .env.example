SECRET_KEY=replace-this-with-a-long-random-secret

# Default: SQLite (no MySQL server required)
# DATABASE_URL=sqlite:///sentinelops_ai.db

# MySQL example:
# DATABASE_URL=mysql+pymysql://root:YOUR_URL_ENCODED_PASSWORD@localhost:3306/sentinelops_ai

# IMPORTANT:
# If your MySQL password contains @, encode it as %40 in this URL.
# Example password: sailu@9014
# Example encoded password: sailu%409014
# Full example:
# DATABASE_URL=mysql+pymysql://root:sailu%409014@localhost:3306/sentinelops_ai

DATABASE_URL=sqlite:///sentinelops_ai.db

# New events that only have a model prediction are used as provisional training rows (1 = yes, 0 = no).
# Analyst-confirmed labels are always used. Test metrics always use real ground truth only.
TRAIN_ON_PREDICTED=1

# ---- Email OTP login ----
# Gmail needs 2-Step Verification ON, then create an App password (Google Account > Security > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=sailajadinesh17@gmail.com
SMTP_PASSWORD=wlsqcntzjcksnoov
MAIL_FROM=sailajadinesh17@gmail.com
# Email given to the built-in "admin" account (receives its login codes)
ADMIN_EMAIL=sailajadinesh17@gmail.com
# Optional emails for the other built-in accounts (each person signs in with their own email + code)
# Role given to people who sign up themselves (Administrator / Analyst / Incident Manager)
SIGNUP_DEFAULT_ROLE=Analyst
ANALYST_EMAIL=
MANAGER_EMAIL=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=30
# 1 = print the code in the server console when SMTP is not configured (development only). Set 0 in production.
OTP_CONSOLE_FALLBACK=1
